PORT=3000
APP_URL=https://localhost
# GitHub OAuth callback: https://localhost/auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth callback: https://localhost/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with crypto.randomBytes(32).toString('hex')
SESSION_SECRET=
INVITATION_DATA_DIR=./data/invitations
# Toss Payments test keys in development; use live keys only in production.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Monthly subscription price in KRW (100 to 5,000,000)
TOSS_AMOUNT_KRW=29000
# Storage: file for local development, mysql for production
DATA_DRIVER=file
MYSQL_URL=
# 32-byte random encryption key as 64 hex characters. Keep stable and back it up.
BILLING_ENCRYPTION_KEY=
# Authorization secret for POST /api/payments/renew
RENEWAL_SECRET=
MYSQL_SSL=false
# Optional absolute path to CA certificate when MYSQL_SSL=true
MYSQL_SSL_CA=
