# Only used by npm run dev:local. Existing production settings are preserved.
PORT=3100
POLAR_ENVIRONMENT=sandbox
# Organization Access Token and recurring product ID from sandbox.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
# Optional GitHub OAuth App callback: http://127.0.0.1:3100/auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
