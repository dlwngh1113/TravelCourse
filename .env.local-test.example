# Used only by npm run dev:local. Production .env.local is not changed.
PORT=3100
# Keys from the same Stripe sandbox. Never use live keys here.
STRIPE_SECRET_KEY=
# From stripe listen, not the deployed Dashboard webhook.
STRIPE_WEBHOOK_SECRET=
# Optional: separate GitHub OAuth App for real local OAuth testing.
# Homepage: http://127.0.0.1:3100
# Callback: http://127.0.0.1:3100/auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
