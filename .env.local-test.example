# Used only by npm run dev:local. Existing production settings are preserved.
PORT=3100
# Use your Toss Payments test client and secret keys here.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_AMOUNT_KRW=1000
# Optional GitHub OAuth App callback: http://127.0.0.1:3100/auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional Google OAuth Client callback: http://127.0.0.1:3100/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated automatically by dev:local when absent; keep stable.
BILLING_ENCRYPTION_KEY=
RENEWAL_SECRET=
